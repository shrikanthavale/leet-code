  {
    "name": "test_client.Cases.test_transactional_batch",
    "description": "A later invalid payment undoes the earlier settlement in the same batch.",
    "events": [
      {
        "id": 1,
        "method": "new",
        "args": [],
        "result": null
      },
      {
        "id": 1,
        "method": "register_invoices",
        "args": [
          [
            "a, 2026-01-01, 10"
          ]
        ],
        "result": [
          201,
          {
            "registered_count": 1
          }
        ]
      },
      {
        "id": 1,
        "method": "reconcile_batch",
        "args": [
          [
            {
              "payment": "p, 10",
              "key": "k"
            },
            {
              "payment": "bad"
            }
          ]
        ],
        "error": {
          "type": "ServiceError",
          "message": "invalid_input",
          "status": 400,
          "code": "invalid_input"
        }
      },
      {
        "id": 1,
        "method": "list_invoices",
        "args": [],
        "result": [
          200,
          [
            {
              "invoice_id": "a",
              "due_date": "2026-01-01",
              "amount_cents": 10,
              "status": "UNPAID",
              "settled_by_payment_id": null
            }
          ]
        ]
      },
      {
        "id": 1,
        "method": "reconcile_payment",
        "args": [
          "q, 10",
          0,
          "k"
        ],
        "result": [
          201,
          {
            "status": "MATCHED",
            "payment_id": "q",
            "settled_invoice_id": "a",
            "tier_used": "exact",
            "message": "Payment q paid 10 for invoice a due on 2026-01-01"
          }
        ]
      }
    ]
  },
  {
    "name": "test_client.Cases.test_unmatched_payment",
    "description": "Returns 200 with UNMATCHED status when no invoice matches.",
    "events": [
      {
        "id": 1,
        "method": "new",
        "args": [],
        "result": null
      },
      {
        "id": 1,
        "method": "register_invoices",
        "args": [
          [
            "INV-1, 2026-05-01, 100"
          ]
        ],
        "result": [
          201,
          {
            "registered_count": 1
          }
        ]
      },
      {
        "id": 1,
        "method": "reconcile_payment",
        "args": [
          "pay_4, 500, no match here",
          0,
          null
        ],
        "result": [
          200,
          {
            "status": "UNMATCHED",
            "payment_id": "pay_4",
            "settled_invoice_id": null,
            "tier_used": null,
            "message": "Payment pay_4 could not be matched to any invoice"
          }
        ]
      }
    ]
  }
]
