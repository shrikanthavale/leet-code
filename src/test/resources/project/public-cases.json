[
  {
    "name": "test_client.Cases.test_register_invoices",
    "description": "Atomically registers an initial batch of open invoices.",
    "events": [
      {
        "id": 1,
        "method": "new",
        "args": [],
        "result": null
      },
      {
        "id": 1,
        "method": "register_invoices",
        "args": [
          [
            "INV-1, 2026-03-01, 100",
            "INV-2, 2026-04-01, 200"
          ]
        ],
        "result": [
          201,
          {
            "registered_count": 2
          }
        ]
      }
    ]
  },
  {
    "name": "test_client.Cases.test_tier1_id_match",
    "description": "Resolves Tier 1 marker even when the payment amount differs.",
    "events": [
      {
        "id": 1,
        "method": "new",
        "args": [],
        "result": null
      },
      {
        "id": 1,
        "method": "register_invoices",
        "args": [
          [
            "INV-7, 2026-03-01, 250",
            "INV-3, 2026-02-01, 100"
          ]
        ],
        "result": [
          201,
          {
            "registered_count": 2
          }
        ]
      },
      {
        "id": 1,
        "method": "reconcile_payment",
        "args": [
          "pay_1, 100, paying for: INV-7",
          0,
          null
        ],
        "result": [
          201,
          {
            "status": "MATCHED",
            "payment_id": "pay_1",
            "settled_invoice_id": "INV-7",
            "tier_used": "id",
            "message": "Payment pay_1 paid 100 for invoice INV-7 due on 2026-03-01"
          }
        ]
      }
    ]
  },
  {
